POSTGRES_DB=dgn_picks
POSTGRES_USER=dgn_picks
POSTGRES_PASSWORD=dgn_picks_local
DATABASE_URL=postgresql+psycopg://dgn_picks:dgn_picks_local@localhost:5432/dgn_picks
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local-only web proxy for the development pick flow and Playwright E2E test.
# Never set either write-mode variable in Railway production.
DGN_API_WRITE_MODE=development
DGN_API_WRITE_KEY=replace-with-a-local-secret
DGN_WEB_WRITE_MODE=development
DGN_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DEV_PICK_WRITES=true
