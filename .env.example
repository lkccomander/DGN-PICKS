# Local PostgreSQL (never commit a real password)
POSTGRES_DB=dgn_picks
POSTGRES_USER=dgn_picks
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://dgn_picks:replace-with-a-local-password@localhost:5432/dgn_picks

# Server-only API origin consumed by the Next.js route handlers
DGN_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional development-only catalog write boundary when API auth is not configured.
# Pick writes require signed bearer sessions and do not use this key.
DGN_API_WRITE_MODE=disabled
DGN_API_WRITE_KEY=replace-with-a-local-secret

# API operator authentication. Use unique, long random values outside local development.
DGN_AUTH_SECRET=replace-with-a-long-random-secret
DGN_AUTH_USERNAME=admin
DGN_AUTH_PASSWORD=replace-with-a-strong-password
DGN_AUTH_ROLE=admin
