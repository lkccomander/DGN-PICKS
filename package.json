{
  "name": "dgn-picks",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "api": "python -m uvicorn dgn_picks_api.main:app --app-dir apps/api/src --reload --port 8000",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build",
    "test:api": "python -m pytest apps/api/tests",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "python -m alembic -c apps/api/alembic.ini upgrade head"
  }
}
